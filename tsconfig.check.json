{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "api/_lib/environment.js",
    "api/_lib/http-body.js",
    "api/_lib/turnstile.js",
    "gestio/src/permissions.js",
    "gestio/src/environment-policy.js"
  ]
}
