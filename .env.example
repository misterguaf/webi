# Grup Scout Parpalló — variables d'entorn de l'endpoint d'alta.
#
# Copia este fitxer a `.env` només per a integracions explícites.
# `.env` està al .gitignore i NO s'ha de pujar mai al repositori.
# En producció estos valors es configuren al panell del hosting
# (Vercel / Netlify / Cloudflare), mai en un fitxer del repositori.

# URL del desplegament d'Apps Script que rep les sol·licituds i les afig
# a la Google Sheet. La copies de "Desplega → Gestiona desplegaments" al
# projecte d'Apps Script (vegeu scripts/google-apps-script.gs i README.md per als passos).
SHEETS_WEBHOOK_URL=

# Clau HMAC compartida entre el servidor i l'Apps Script. Ha de ser el MATEIX
# valor que has posat a "Configuració del projecte → Propietats de l'script"
# amb el nom WEBHOOK_HMAC_SECRET. Fes-lo llarg i aleatori (32+ caràcters).
# Mai viatja en clar: el servidor només envia una firma HMAC amb caducitat curta.
SHEETS_SHARED_SECRET=

# Origen permès per a enviar el formulari, sense barra final.
# Amb APP_ENV=production, configura un origen HTTPS vàlid i exacte, sense path.
# Si està buit o és invàlid en production, els enviaments sensibles es rebutgen
# (fail-closed). El mode local segur no fa egress real.
ALLOWED_ORIGIN=

# Portal privat: són secrets del SEGON Worker i es configuren amb Wrangler.
# Es documenten ací només els noms; no poses mai els valors al repositori.
PORTAL_ACCESS_PASSWORD=
PORTAL_SESSION_SECRET=
PORTAL_SESSION_VERSION=2026-2027
PORTAL_ALLOWED_ORIGIN=https://inscripciones.grupscoutparpallo.com
# L'entorn local força sempre `development`. El Worker desplegat declara
# `production` en wrangler.toml.
APP_ENV=development

# Doble opt-in obligatori per a `npm run dev:site:integration`.
# Mantín-lo en false per defecte. L'allowlist accepta orígens exactes separats
# per comes, sense paths ni comodins (p. ex. https://script.google.com).
ALLOW_REAL_EGRESS=false
DEV_EGRESS_ALLOWLIST=
